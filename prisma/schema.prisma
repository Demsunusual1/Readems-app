generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  READER
  CREATOR
  BOTH
}

model User {
  id              String            @id @default(cuid())
  fullName        String
  username        String            @unique
  email           String            @unique
  passwordHash    String
  role            UserRole
  bio             String?
  avatarUrl       String?
  interests       String[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  sessions        Session[]
  readingProgress ReadingProgress[]
  stories         Story[]
  libraryItems    LibraryItem[]
  readingLists    ReadingList[]
  readingGoal     ReadingGoal?
  storyLikes      StoryLike[]
  reviews         Review[]
  reviewLikes     ReviewLike[]
}

model ReadingProgress {
  userId      String
  storyId     String
  chapter     Int
  paragraph   Int
  completed   Boolean   @default(false)
  percent     Int       @default(0)
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  story       Story     @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@id([userId, storyId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum StoryStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum ChapterStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

// The id is the URL slug, so story links stay readable and stable.
model Story {
  id           String            @id
  title        String
  synopsis     String
  coverUrl     String
  genre        String
  audience     String            @default("General")
  language     String            @default("English")
  tags         String[]
  featured     Boolean           @default(false)
  status       StoryStatus       @default(DRAFT)
  publishedAt  DateTime?
  scheduledFor DateTime?
  authorId     String
  author       User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  chapters     Chapter[]
  libraryItems LibraryItem[]
  listItems    ReadingListItem[]
  progress     ReadingProgress[]
  likes        StoryLike[]
  reviews      Review[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([status, publishedAt])
  @@index([authorId])
}

model Chapter {
  id           String        @id @default(cuid())
  storyId      String
  story        Story         @relation(fields: [storyId], references: [id], onDelete: Cascade)
  number       Int
  title        String
  body         String
  authorNote   String?
  status       ChapterStatus @default(DRAFT)
  publishedAt  DateTime?
  scheduledFor DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([storyId, number])
  @@index([storyId, status])
}

model LibraryItem {
  id      String   @id @default(cuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storyId String
  story   Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  savedAt DateTime @default(now())

  @@unique([userId, storyId])
  @@index([userId, savedAt])
}

model ReadingList {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  isPublic    Boolean           @default(false)
  items       ReadingListItem[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([userId, title])
}

model ReadingListItem {
  listId  String
  list    ReadingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  storyId String
  story   Story       @relation(fields: [storyId], references: [id], onDelete: Cascade)
  addedAt DateTime    @default(now())

  @@id([listId, storyId])
}

model ReadingGoal {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  target    Int      @default(12)
  year      Int
  updatedAt DateTime @updatedAt
}

model StoryLike {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storyId   String
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, storyId])
  @@index([storyId])
}

model Review {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  storyId   String
  story     Story        @relation(fields: [storyId], references: [id], onDelete: Cascade)
  rating    Int
  body      String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  likes     ReviewLike[]

  @@unique([userId, storyId])
  @@index([storyId, createdAt])
}

model ReviewLike {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, reviewId])
}
