generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  READER
  CREATOR
  BOTH
}

model User {
  id               String               @id @default(cuid())
  fullName         String
  username         String               @unique
  email            String               @unique
  passwordHash     String
  role             UserRole
  bio              String?
  avatarUrl        String?
  interests        String[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  sessions         Session[]
  readingProgress  ReadingProgress[]
  stories          Story[]
  libraryItems     LibraryItem[]
  readingLists     ReadingList[]
  readingGoal      ReadingGoal?
  storyLikes       StoryLike[]
  reviews          Review[]
  reviewLikes      ReviewLike[]
  comments         Comment[]
  commentLikes     CommentLike[]
  following        Follow[]             @relation("Following")
  followers        Follow[]             @relation("Followers")
  posts            Post[]
  postLikes        PostLike[]
  postComments     PostComment[]
  groupsCreated    Group[]
  groupMemberships GroupMember[]
  eventRsvps       GroupEventRsvp[]
  notifications    Notification[]       @relation("Recipient")
  actedOn          Notification[]       @relation("Actor")
  settings         UserSettings?
  blocking         Block[]              @relation("Blocker")
  blockedBy        Block[]              @relation("Blocked")
  adminRole        AdminRole            @default(NONE)
  accountStatus    AccountStatus        @default(ACTIVE)
  suspendedAt      DateTime?
  conversations    ConversationMember[]
  messagesSent     Message[]
  roomsHosted      Room[]
  roomsJoined      RoomParticipant[]
  roomMessages     RoomMessage[]
  roomReactions    RoomReaction[]
  reportsMade      Report[]             @relation("Reporter")
  reportsAssigned  Report[]             @relation("Assignee")
  reportsResolved  Report[]             @relation("Resolver")
  dealsCreated     BrandDeal[]          @relation("DealCreator")
}

model ReadingProgress {
  userId      String
  storyId     String
  chapter     Int
  paragraph   Int
  completed   Boolean   @default(false)
  percent     Int       @default(0)
  completedAt DateTime?
  startedAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  story       Story     @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@id([userId, storyId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum StoryStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum ChapterStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

// The id is the URL slug, so story links stay readable and stable.
model Story {
  id           String            @id
  title        String
  synopsis     String
  coverUrl     String
  genre        String
  audience     String            @default("General")
  language     String            @default("English")
  tags         String[]
  featured     Boolean           @default(false)
  status       StoryStatus       @default(DRAFT)
  publishedAt  DateTime?
  scheduledFor DateTime?
  hiddenAt     DateTime?
  authorId     String
  author       User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  chapters     Chapter[]
  libraryItems LibraryItem[]
  listItems    ReadingListItem[]
  progress     ReadingProgress[]
  likes        StoryLike[]
  reviews      Review[]
  posts        Post[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([status, publishedAt])
  @@index([authorId])
}

model Chapter {
  id           String        @id @default(cuid())
  storyId      String
  story        Story         @relation(fields: [storyId], references: [id], onDelete: Cascade)
  number       Int
  title        String
  body         String
  authorNote   String?
  status       ChapterStatus @default(DRAFT)
  publishedAt  DateTime?
  scheduledFor DateTime?
  hiddenAt     DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  comments Comment[]

  @@unique([storyId, number])
  @@index([storyId, status])
}

model LibraryItem {
  id      String   @id @default(cuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storyId String
  story   Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  savedAt DateTime @default(now())

  @@unique([userId, storyId])
  @@index([userId, savedAt])
}

model ReadingList {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  isPublic    Boolean           @default(false)
  items       ReadingListItem[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([userId, title])
}

model ReadingListItem {
  listId  String
  list    ReadingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  storyId String
  story   Story       @relation(fields: [storyId], references: [id], onDelete: Cascade)
  addedAt DateTime    @default(now())

  @@id([listId, storyId])
}

model ReadingGoal {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  target    Int      @default(12)
  year      Int
  updatedAt DateTime @updatedAt
}

model StoryLike {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storyId   String
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, storyId])
  @@index([storyId])
}

model Review {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  storyId   String
  story     Story        @relation(fields: [storyId], references: [id], onDelete: Cascade)
  rating    Int
  body      String?
  hiddenAt  DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  likes     ReviewLike[]

  @@unique([userId, storyId])
  @@index([storyId, createdAt])
}

model ReviewLike {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, reviewId])
}

model Comment {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapterId String
  chapter   Chapter       @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]     @relation("CommentReplies")
  body      String
  hiddenAt  DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  likes     CommentLike[]

  @@index([chapterId, createdAt])
  @@index([parentId])
}

model CommentLike {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, commentId])
}

model Follow {
  followerId  String
  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@id([followerId, followingId])
  @@index([followingId])
}

enum PostKind {
  THOUGHT
  SHORT_STORY
  POEM
  QUESTION
}

model Prompt {
  id        String   @id @default(cuid())
  title     String
  body      String
  weekOf    DateTime @unique
  createdAt DateTime @default(now())
  posts     Post[]
}

model Post {
  id        String        @id @default(cuid())
  authorId  String
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  groupId   String?
  group     Group?        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  promptId  String?
  prompt    Prompt?       @relation(fields: [promptId], references: [id], onDelete: SetNull)
  storyId   String?
  story     Story?        @relation(fields: [storyId], references: [id], onDelete: SetNull)
  kind      PostKind      @default(THOUGHT)
  topic     String?
  title     String?
  body      String
  hiddenAt  DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  likes     PostLike[]
  comments  PostComment[]

  @@index([groupId, createdAt])
  @@index([authorId, createdAt])
  @@index([topic, createdAt])
}

model PostLike {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, postId])
}

model PostComment {
  id        String    @id @default(cuid())
  postId    String
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  hiddenAt  DateTime?
  createdAt DateTime  @default(now())

  @@index([postId, createdAt])
}

enum GroupRole {
  MEMBER
  MODERATOR
  FOUNDER
}

model Group {
  id          String        @id
  name        String
  tagline     String
  description String
  topic       String
  coverUrl    String?
  isPublic    Boolean       @default(true)
  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  members     GroupMember[]
  posts       Post[]
  events      GroupEvent[]

  @@index([topic])
}

model GroupMember {
  groupId  String
  group    Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  @@id([groupId, userId])
  @@index([userId])
}

model GroupEvent {
  id          String           @id @default(cuid())
  groupId     String
  group       Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title       String
  description String
  startsAt    DateTime
  createdById String
  createdAt   DateTime         @default(now())
  rsvps       GroupEventRsvp[]

  @@index([groupId, startsAt])
}

model GroupEventRsvp {
  eventId   String
  event     GroupEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@id([eventId, userId])
}

enum NotificationKind {
  FOLLOW
  CHAPTER
  COMMENT
  REPLY
  LIKE
  REVIEW
  GROUP
  MILESTONE
  SYSTEM
}

enum NotificationCategory {
  READING
  COMMUNITY
  CREATOR
}

model Notification {
  id        String               @id @default(cuid())
  userId    String
  user      User                 @relation("Recipient", fields: [userId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?                @relation("Actor", fields: [actorId], references: [id], onDelete: SetNull)
  kind      NotificationKind
  category  NotificationCategory
  title     String
  body      String
  href      String
  readAt    DateTime?
  createdAt DateTime             @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model UserSettings {
  userId              String   @id
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme               String   @default("system")
  language            String   @default("English")
  country             String?
  emailNotifications  Boolean  @default(true)
  profilePublic       Boolean  @default(true)
  showReadingActivity Boolean  @default(false)
  updatedAt           DateTime @updatedAt
}

model Block {
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

model Conversation {
  id           String               @id @default(cuid())
  isGroup      Boolean              @default(false)
  title        String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  participants ConversationMember[]
  messages     Message[]
}

model ConversationMember {
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Room {
  id           String            @id
  title        String
  tagline      String
  description  String
  coverUrl     String?
  hostId       String
  host         User              @relation(fields: [hostId], references: [id], onDelete: Cascade)
  isLive       Boolean           @default(true)
  createdAt    DateTime          @default(now())
  messages     RoomMessage[]
  participants RoomParticipant[]
  reactions    RoomReaction[]
}

model RoomParticipant {
  roomId     String
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt   DateTime @default(now())
  handRaised Boolean  @default(false)
  onStage    Boolean  @default(false)

  @@id([roomId, userId])
  @@index([userId])
}

model RoomMessage {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([roomId, createdAt])
}

model RoomReaction {
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  createdAt DateTime @default(now())

  @@id([roomId, userId, kind])
}

enum AdminRole {
  NONE
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum ReportTarget {
  STORY
  CHAPTER
  COMMENT
  POST
  POST_COMMENT
  REVIEW
  USER
}

enum ReportStatus {
  OPEN
  APPROVED
  RESTRICTED
  REMOVED
}

enum ReportPriority {
  LOW
  MEDIUM
  HIGH
}

model Report {
  id           String         @id @default(cuid())
  reporterId   String?
  reporter     User?          @relation("Reporter", fields: [reporterId], references: [id], onDelete: SetNull)
  targetType   ReportTarget
  targetId     String
  reason       String
  details      String?
  status       ReportStatus   @default(OPEN)
  priority     ReportPriority @default(MEDIUM)
  assignedToId String?
  assignedTo   User?          @relation("Assignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  resolvedById String?
  resolvedBy   User?          @relation("Resolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt   DateTime?
  createdAt    DateTime       @default(now())

  @@index([status, createdAt])
  @@index([targetType, targetId])
}

enum DealStatus {
  DRAFT
  PENDING
  LIVE
  COMPLETED
}

model BrandDeal {
  id           String     @id @default(cuid())
  name         String
  sponsor      String
  category     String
  region       String
  status       DealStatus @default(DRAFT)
  valueCents   Int        @default(0)
  creatorSlots Int        @default(0)
  startsAt     DateTime?
  endsAt       DateTime?
  createdById  String?
  createdBy    User?      @relation("DealCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([status, createdAt])
}
